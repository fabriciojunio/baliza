.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# A base bruta tem 5 GB e e publica: quem quiser reproduz com um comando.
dados/
# Saida de treino: pesa centenas de megabytes e o que interessa dela
# (pesos e graficos) e copiado para modelos/ e docs/treino/.
runs/

# Metadados gerados pelo pip install -e
src/*.egg-info/

# O painel grava a execucao dele num banco proprio, apagado e refeito a cada
# clique em Processar. Um deles foi parar no repositorio sem querer.
demo/historico/*_painel.db

# O ultralytics baixa o yolo11n na pasta de onde o comando roda. O do projeto
# vive em modelos/, e essa copia da raiz e byte a byte a mesma coisa.
/yolo11n.pt
